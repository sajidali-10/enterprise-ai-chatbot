# ==============================================================================
# Enterprise AI Chatbot — Git Ignore Rules
# ==============================================================================

# -----------------------------------------------------------------------------
# Environment Files (NEVER commit these)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
.tox/
.nox/

# Virtual environments
venv/
.venv/
ENV/
env/

# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
node_modules/
.npm
.yarn/
.pnp
.pnp.js

# Next.js build outputs
.next/
out/
build/

# React / Next.js
.cache/

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# Local volume mounts (these are named volumes, but include for safety)
postgres_data/
qdrant_data/
redis_data/
minio_data/

# Docker compose override
docker-compose.override.yml

# -----------------------------------------------------------------------------
# IDE & Editors
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.tgz
*.tar.gz
*.zip
.tmp/
.temp/
# Kimchi runtime/session files
.kimchi/

# Evaluation generated result files
apps/backend/evaluations/results/*.json
apps/backend/evaluations/results/*.md
!apps/backend/evaluations/results/.gitkeep

# ---------------------------------------------------------------------------
# Secrets & Credentials (NEVER commit these)
# ---------------------------------------------------------------------------
# Environment files
.env
.env.*
*.env
*.env.*
.env-bk
.env.bak*

# Secret directories and files
secrets/
secret/
credentials/
*.secret
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der

# SSH keys
id_*
!id_*.pub
*.pub.key

# Kubernetes secrets
*secret*.yaml
*secret*.yml

# AWS credentials
.aws/

# GCP / Service account keys (common filenames)
credentials.json
credentials.yml
*service-account*.json
*service_account*.json

# Local SSL/TLS certs
certs/
*.ssl
*.tls

# -----------------------------------------------------------------------------
# Local Backup Files (never commit backups)
# -----------------------------------------------------------------------------
*.bak
*.backup
*-backup*
*-bk
*.old
*.orig
*-old
*-orig
