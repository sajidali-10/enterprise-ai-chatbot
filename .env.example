# ==============================================================================
# Enterprise AI Chatbot — Environment Variables
# ==============================================================================
# Copy this file to .env and update values as needed for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# -----------------------------------------------------------------------------
# Project Configuration
# -----------------------------------------------------------------------------
PROJECT_NAME=AI Chatbot
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Qdrant Vector Database Configuration
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO Object Storage Configuration
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=chatbot-uploads

# -----------------------------------------------------------------------------
# Python Configuration
# -----------------------------------------------------------------------------
PYTHONUNBUFFERED=1

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Provider selection: mock (default), openai, openrouter, ollama, litellm
LLM_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenRouter Configuration (recommended for development)
# Get your API key at: https://openrouter.ai/keys
# Low-cost models: google/gemini-2.0-flash-exp, anthropic/claude-3-haiku, meta-llama/llama-3-8b-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Enterprise AI Chatbot

# Ollama Configuration (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LiteLLM Configuration (unified interface to 100+ LLMs)
LITELLM_API_KEY=
LITELLM_BASE_URL=
LITELLM_MODEL=gpt-4o-mini

# Document Upload
UPLOAD_MAX_SIZE_MB=10

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Chunking Configuration
CHUNK_SIZE=3000
CHUNK_OVERLAP=400

# Embedding Configuration
# Provider: mock (testing only), openai (API key required), local (sentence-transformers, no API key)
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=384
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1

# Retrieval Settings (Phase 5 - Hybrid Search & Reranking)
RETRIEVAL_VECTOR_TOP_K=15
RETRIEVAL_KEYWORD_TOP_K=15
RETRIEVAL_FINAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.1
RETRIEVAL_RERANKER_TYPE=noop
RETRIEVAL_RERANK_FINAL_K=20
RETRIEVAL_VECTOR_WEIGHT=0.7
RETRIEVAL_KEYWORD_WEIGHT=0.3
RETRIEVAL_QUERY_REWRITER=passthrough
RETRIEVAL_SHOW_DEBUG=false

# Security Settings (Phase 6 - Authentication & Authorization)
AUTH_ENABLED=false
DEV_AUTH_ENABLED=true
DEV_USER_SECRET=dev-secret-change-in-production
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=