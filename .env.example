# ==============================================================================
# Enterprise AI Chatbot — Environment Variables
# ==============================================================================
# Copy this file to .env and update values as needed for your environment.
# NEVER commit .env to version control.
#
# ⚠️  SECURITY WARNING: Replace ALL placeholder values before deploying to
#     production. Never use default passwords or the example JWT secret key.
# ==============================================================================

# -----------------------------------------------------------------------------
# Project Configuration
# -----------------------------------------------------------------------------
PROJECT_NAME=AI Chatbot
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
# WARNING: Change this to a strong random password in production
POSTGRES_PASSWORD=changeme
# Optional: override the full database URL (defaults to postgres://... above)
# DATABASE_URL=postgresql://chatbot:changeme@postgres:5432/chatbot

# -----------------------------------------------------------------------------
# Qdrant Vector Database Configuration
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO Object Storage Configuration
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
# WARNING: Change these to strong random credentials in production
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=chatbot-uploads

# -----------------------------------------------------------------------------
# Python Configuration
# -----------------------------------------------------------------------------
PYTHONUNBUFFERED=1

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Provider selection: mock (default), openai, openrouter, ollama, litellm
LLM_PROVIDER=mock

# OpenAI Configuration
# Set OPENAI_API_KEY to a valid OpenAI API key for production use
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenRouter Configuration (recommended for development)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Enterprise AI Chatbot

# Ollama Configuration (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ==============================================================================
# LiteLLM Gateway Configuration (Phase 15)
# ==============================================================================
# LiteLLM Gateway is a self-hosted proxy that routes LLM calls to multiple providers.
# Use this when you want centralized governance, failover, and cost controls.
#
# When LITELLM_ENABLED=true:
#   - LiteLLM Gateway service must be running (via docker compose)
#   - Backend routes LLM calls through the gateway (LLM_PROVIDER=litellm)
#   - API keys are configured in infra/litellm/config.yaml (not here)
#
# When LITELLM_ENABLED=false (default):
#   - Use LLM_PROVIDER=openrouter for direct OpenRouter calls (no gateway)
# ==============================================================================

# Enable/disable LiteLLM Gateway mode
LITELLM_ENABLED=false

# LiteLLM Gateway base URL (internal Docker network)
LITELLM_BASE_URL=http://litellm:4000

# LiteLLM Gateway master key (must match LITELLM_MASTER_KEY in docker-compose)
# WARNING: Change this to a strong random key in production!
LITELLM_MASTER_KEY=changeme_litellm_master_key

# Default model to use when LLM_PROVIDER=litellm
# Available models (defined in infra/litellm/config.yaml):
#   openrouter-gpt-oss    → google/gemini-2.0-flash-exp via OpenRouter (recommended)
#   openrouter-claude     → anthropic/claude-3-haiku via OpenRouter
#   openrouter-llama      → meta-llama/llama-3-8b-instruct via OpenRouter
#   openrouter-free       → mistralai/mistral-7b-instruct via OpenRouter
#   local-ollama          → llama3.2 via local Ollama
LITELLM_MODEL=openrouter-gpt-oss

# External port for LiteLLM Gateway (set only if you need host access)
# Default: 4000 (only exposed if LITELLM_ENABLED=true and service is up)
# LITELLM_EXTERNAL_PORT=4000

# -----------------------------------------------------------------------------
# Vector Database
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# -----------------------------------------------------------------------------
# Chunking Configuration
# -----------------------------------------------------------------------------
CHUNK_SIZE=3000
CHUNK_OVERLAP=400

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
# Provider: mock (testing only), openai (API key required), local (sentence-transformers, no API key)
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=384
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Retrieval Settings (Phase 5 - Hybrid Search & Reranking)
# -----------------------------------------------------------------------------
RETRIEVAL_VECTOR_TOP_K=15
RETRIEVAL_KEYWORD_TOP_K=15
RETRIEVAL_FINAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.1
RETRIEVAL_RERANKER_TYPE=noop
RETRIEVAL_RERANK_FINAL_K=20
RETRIEVAL_VECTOR_WEIGHT=0.7
RETRIEVAL_KEYWORD_WEIGHT=0.3
RETRIEVAL_QUERY_REWRITER=passthrough
RETRIEVAL_SHOW_DEBUG=false

# -----------------------------------------------------------------------------
# Answer Grounding & Hallucination Prevention
# -----------------------------------------------------------------------------
RAG_MIN_RELEVANCE_SCORE=0.3

# -----------------------------------------------------------------------------
# Phase 34A.1 — RAG Retrieval & DB Migration Hardening
# -----------------------------------------------------------------------------
# Maximum candidate chunks returned by the initial hybrid retrieval
# (ceiling before final thresholding / exact-match reranking).
RAG_MAX_RETRIEVED_CANDIDATES=30
# Maximum final sources forwarded to the LLM after relevance thresholding.
RAG_MAX_FINAL_SOURCES=6
# Multiplicative boost per exact error-code hit during reranking.
RAG_EXACT_MATCH_BOOST=0.30
# Multiplicative boost per exact technical-term hit (e.g. rejected-forbidden-country).
RAG_EXACT_TERM_BOOST=0.15
# Master switch for image-aware query routing (OCR scoping).
RAG_IMAGE_AWARE_ROUTING_ENABLED=true
# Minimum fused-retrieval score required for a chunk to be forwarded
# to the LLM. Chunks below this are dropped before the LLM is called.
RAG_MIN_RELEVANCE_FLOOR=0.10
# Production schema policy. When false (default), the backend does NOT
# call Base.metadata.create_all() on startup — Alembic is the sole
# owner of production schema. Set to true ONLY for local dev/test
# against a fresh SQLite database.
DB_AUTO_CREATE_SCHEMA=false

# -----------------------------------------------------------------------------
# Phase 31B — LangGraph Agentic RAG Pilot (optional, off by default)
# -----------------------------------------------------------------------------
# Master switch for the agentic RAG pilot. When false the agentic pipeline
# is fully inert (not imported at request time) and classic knowledge_base
# behavior is unchanged. Set to true to opt in.
RAG_AGENTIC_ENABLED=false
# Framework selector. Today only "langgraph" is supported.
RAG_AGENTIC_FRAMEWORK=langgraph
# Whether mode=knowledge_base requests should route through the agentic
# pipeline by default. When false (the safe default), only explicit
# mode=agentic_knowledge_base requests use the agentic path.
RAG_AGENTIC_DEFAULT=false
# Maximum retrieve/rewrite cycles before the agentic graph finalizes.
RAG_AGENTIC_MAX_RETRIES=1
# Whether the rewrite_query_if_needed node may trigger a rewrite when
# evidence is weak.
RAG_AGENTIC_REWRITE_ENABLED=true
# Whether the verify_citations node enforces citations on the answer.
RAG_AGENTIC_REQUIRE_CITATIONS=true
# When true any unhandled exception in the agentic graph falls back to
# the classic pipeline instead of failing the request.
RAG_AGENTIC_FALLBACK_TO_CLASSIC=true

# -----------------------------------------------------------------------------
# Document Upload
# -----------------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB=10

# -----------------------------------------------------------------------------
# Security Settings (Phase 14 - Production Security Hardening)
# -----------------------------------------------------------------------------

# Authentication mode:
#   dev  = development mode with X-Dev-User header bypass
#   local = production JWT-based local authentication
AUTH_MODE=local

# JWT Configuration
# WARNING: Generate a strong random secret (e.g. openssl rand -base64 48)
# and keep it secure. Changing this will invalidate all existing sessions.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bootstrap admin user (only used when AUTH_MODE=local and no admin exists)
# WARNING: Change the password immediately after first login!
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# CORS Configuration
# In production, set this to your frontend origin(s), comma-separated.
# Example: CORS_ALLOWED_ORIGINS=https://chatbot.example.com,https://admin.example.com
# In dev mode, localhost origins are automatically allowed.
CORS_ALLOWED_ORIGINS=https://chatbot.example.com

# -----------------------------------------------------------------------------
# Nginx / Public Deployment (Phase 17)
# -----------------------------------------------------------------------------
# CHATBOT_DOMAIN: Your registered domain name
# Replace with your actual domain before deploying.
CHATBOT_DOMAIN=chatbot.example.com

# NEXT_PUBLIC_API_BASE_URL: Frontend uses this to reach the backend API.
# With Nginx reverse proxy, use same-origin /api/ routing (no explicit port).
# The frontend will call https://chatbot.example.com/api/... and Nginx
# routes /api/* to backend:8000.
NEXT_PUBLIC_API_BASE_URL=https://${CHATBOT_DOMAIN}

# Rate Limiting

# Rate Limiting
# Set to false to disable rate limiting (useful for testing only)
RATE_LIMIT_ENABLED=true

# OIDC / SSO (reserved for future phases)
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Phase 34A — Enterprise OCR & Image Ingestion
# -----------------------------------------------------------------------------
# Master switch. When false, direct image uploads return a clear 4xx
# error and the rest of the OCR subsystem is bypassed. Text-only
# document uploads are unaffected.
OCR_ENABLED=true
# Active OCR provider. Only "tesseract" is implemented in Phase 34A.
OCR_PROVIDER=tesseract
# Tesseract language code(s). Comma-separate for multi-language OCR.
OCR_LANGUAGE=eng
# 0-100. Below this, OCR rows are flagged low_confidence (still indexed).
OCR_MIN_CONFIDENCE=60
# PDF OCR fallback — enable OCR for pages whose native text is below
# OCR_PDF_PAGE_TEXT_MIN_CHARS.
OCR_PDF_FALLBACK=true
OCR_PDF_PAGE_TEXT_MIN_CHARS=40
# DOCX embedded-image OCR.
OCR_DOCX_IMAGES=true
OCR_DOCX_IMAGE_MAX_COUNT=50
# Per-image safety caps.
OCR_IMAGE_MAX_SIZE_MB=15
OCR_RENDER_DPI=200
OCR_TIMEOUT_S=120
OCR_UPSCALING_ENABLED=true
# Optional override for the Tesseract data directory.
TESSDATA_PREFIX=
